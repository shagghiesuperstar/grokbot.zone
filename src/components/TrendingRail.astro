---
import RivePlayer from './RivePlayer.astro';
import BotCard from './BotCard.astro';
import { botBySlug, trending } from '../lib/data';
const bots = trending.global.map((s) => botBySlug.get(s)!).filter(Boolean);
---
{bots.length > 0 && (
  <section class="block wrap" aria-labelledby="trending-h" data-rail="trending">
    <div class="section-head">
      <h2 id="trending-h" class="th"><RivePlayer box="inline" size="32px" src="/riv/bot-pulse.riv"><span class="pdot"></span></RivePlayer>Trending</h2>
      <p class="asof">Popularity order as of <time datetime={trending.asOf}>{trending.asOf}</time>. A dated snapshot, not a live feed.</p>
    </div>
    <ul class="grid">
      {bots.map((b) => <li><BotCard bot={b} trending showCategory /></li>)}
    </ul>
  </section>
)}
<style>
  .th { display: flex; align-items: center; gap: .5rem; }
  .pdot { position: absolute; left: 50%; top: 50%; width: 10px; height: 10px; margin: -5px 0 0 -5px; border-radius: 50%; background: var(--olo); }
</style>
