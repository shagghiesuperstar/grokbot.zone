---
import type { Category } from '../lib/data';
interface Props {
  category: Category;
  /** Heading level for the category name. Listings that sit directly under the page h1 use 2. */
  level?: 2 | 3;
}
const { category: c, level = 3 } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
---
<a class="cc panel" href={`/categories/${c.slug}/`}>
  <Heading class="label">{c.label}</Heading>
  <p class="p">{c.purpose}</p>
  <p class="n"><span class="num">{c.count}</span> bots</p>
</a>
<style>
  .cc { display: flex; flex-direction: column; gap: .4rem; padding: 1.1rem 1.2rem; text-decoration: none; color: var(--text); height: 100%; }
  .cc:hover { border-color: var(--olo); }
  .label { font-size: 1.25rem; }
  .p { margin: 0; color: var(--text-muted); font-size: .92rem; }
  .n { margin: auto 0 0; padding-top: .4rem; color: var(--olo); font-size: .9rem; }
</style>
