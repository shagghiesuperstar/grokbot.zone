---
import Base from '../layouts/Base.astro';
---
<Base title="GrokBot Zone | Find a Grok bot for any job" description="Search and browse public Grok bot listings by function. Find the bot for the job, then open it.">
  <section class="hero">
    <div class="hero-grid-fallback" aria-hidden="true"></div>
    <div class="wrap">
      <h1><span class="line">Find the bot.</span><span class="line accent">Skip the hunt.</span></h1>
      <p class="lede">A searchable index of public Grok bot listings, sorted by what they do.</p>
    </div>
  </section>
</Base>
