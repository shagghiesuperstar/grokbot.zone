---
import { REFERRAL_URL } from '../lib/referral';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<section class:list={['cta panel', { compact }]} aria-labelledby={compact ? 'cta-h-c' : 'cta-h'} data-referral>
  <div>
    <h2 id={compact ? 'cta-h-c' : 'cta-h'}>New to Grok Bot?</h2>
    <p class="muted">Pick a bot from the list, or start with Grok Bot itself. This is a referral link: if you sign up through it, we may be credited at no cost to you.</p>
  </div>
  <a class="btn" href={REFERRAL_URL} rel="sponsored noopener" target="_blank">Try Grok Bot</a>
</section>
<style>
  .cta { display: flex; flex-wrap: wrap; gap: 1.25rem 2rem; align-items: center; justify-content: space-between; padding: 1.75rem 2rem; border-color: var(--olo); }
  .cta h2 { margin-bottom: .5rem; }
  .cta p { margin: 0; max-width: 60ch; }
  .cta.compact { padding: 1.25rem 1.5rem; margin: 2rem 0 0; }
  .cta.compact h2 { font-size: 1.5rem; }
</style>
