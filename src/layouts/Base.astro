---
import '@fontsource/anton/400.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/800.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WebMcp from '../components/WebMcp.astro';

interface Props {
  title: string;
  description: string;
  path?: string; // pathname with leading and trailing slash
  jsonLd?: unknown[];
  noindex?: boolean;
  ogType?: string;
}
const { title, description, path = Astro.url.pathname, jsonLd = [], noindex = false, ogType = 'website' } = Astro.props;
const canonical = new URL(path, Astro.site).toString();
// Escape "<" so structured data can never close the script element early.
const ld = jsonLd.map((o) => JSON.stringify(o).replace(/</g, '\\u003c'));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#030203" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="GrokBot Zone" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/markdown" href={path} />
    <link rel="ai-catalog" href="/.well-known/ai-catalog.json" />
    {ld.map((j) => <script type="application/ld+json" set:html={j} />)}
  </head>
  <body>
    <div id="bg-video" aria-hidden="true"><video muted loop playsinline preload="none" disablepictureinpicture tabindex="-1" poster="/media/hero-poster-v1.webp"></video></div>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <WebMcp />
    <script is:inline type="module">
      // Background video: starts after load, zooms 1.00 -> 1.50 over the first 3000px of scroll.
      // Reduced motion or Save-Data: poster only, no src, no zoom.
      const box = document.getElementById('bg-video');
      const video = box.firstElementChild;
      const reduce = matchMedia('(prefers-reduced-motion: reduce)');
      const still = () => reduce.matches || navigator.connection?.saveData === true;
      let frame = 0, started = false;
      const zoom = () => {
        frame = 0;
        box.style.transform = still() ? '' : `scale(${1 + 0.5 * Math.min(scrollY / 3000, 1)})`;
      };
      const start = () => {
        if (started || still()) return;
        started = true;
        video.src = matchMedia('(max-width: 640px)').matches ? '/media/hero-loop-v1-720.mp4' : '/media/hero-loop-v1-1088.mp4';
        video.play()?.catch((e) => {
          if (e.name !== 'NotAllowedError') return; // Low Power Mode: leave the poster
          video.removeAttribute('src'); video.load(); started = false;
        });
      };
      const stop = () => { video.pause(); video.removeAttribute('src'); video.load(); started = false; };
      addEventListener('scroll', () => { frame ||= requestAnimationFrame(zoom); }, { passive: true });
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) video.pause();
        else if (started && !still()) video.play()?.catch(() => {});
      });
      reduce.addEventListener('change', () => { if (still()) stop(); else if (document.readyState === 'complete') start(); zoom(); });
      const begin = () => (window.requestIdleCallback ? requestIdleCallback(start, { timeout: 2000 }) : setTimeout(start, 200));
      zoom();
      if (document.readyState === 'complete') begin(); else addEventListener('load', begin, { once: true });
    </script>
  </body>
</html>
